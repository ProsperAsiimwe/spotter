# Python bytecode/cache
__pycache__/
*.py[cod]
*$py.class
.pycache/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables / secrets
.env
.env.*
!.env.example
# Packaging/build artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Test and tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.hypothesis/

# IDE/editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Runtime logs / pid files
*.log
*.pid

# Jupyter
.ipynb_checkpoints/

# Fitted artifacts (commit with: git add -f models/rate_model.joblib)
models/*
!models/.gitkeep
!models/archives/
!models/archives/.gitkeep
models/archives/*
!models/archives/.gitkeep

# Local scorer output except the required chart
scorer_results/*
!scorer_results/.gitkeep
!scorer_results/candidate_december.png
